
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>{{ title or "CoopFinance" }} - CoopFinance</title>

    <!-- CSS original do Mazer -->
    <link rel="stylesheet" href="/assets/compiled/css/app.css">
    <link rel="stylesheet" href="/assets/compiled/css/app-dark.css">

    <!-- Personalização do nosso sistema -->
    <link rel="stylesheet" href="/css/financeiro.css">
</head>

<body>
    <!-- Inicializa o tema antes de desenhar a página -->
    <script src="/assets/static/js/initTheme.js"></script>

    <div id="app">

        <!-- MENU LATERAL -->
        <div id="sidebar">
            <div class="sidebar-wrapper active">

                <div class="sidebar-header position-relative">
                    <div class="d-flex justify-content-between align-items-center">

                        <div class="logo">
                            <a href="/home" class="logo-financeiro">
                                <i class="bi bi-bank2"></i>
                                Coop<span>Finance</span>
                            </a>
                        </div>

                        <!-- Alternância entre tema claro e escuro -->
                        <div class="theme-toggle d-flex align-items-center">
                            <div class="form-check form-switch">
                                <input class="form-check-input"
                                       type="checkbox"
                                       id="toggle-dark">
                            </div>
                        </div>

                    </div>
                </div>

                <div class="sidebar-menu">
                    <ul class="menu">

                        <li class="sidebar-title">Financeiro</li>

                        <li class="sidebar-item {% if activeMenu == 'home' %}active{% endif %}">
                            <a href="/home" class="sidebar-link">
                                <i class="bi bi-grid-fill"></i>
                                <span>Visão geral</span>
                            </a>
                        </li>

                        <li class="sidebar-item {% if activeMenu == 'categorias' %}active{% endif %}">
                            <a href="/categorias" class="sidebar-link">
                                <i class="bi bi-tags-fill"></i>
                                <span>Categorias</span>
                            </a>
                        </li>

                        <li class="sidebar-item {% if activeMenu == 'contas' %}active{% endif %}">
                            <a href="/contas" class="sidebar-link">
                                <i class="bi bi-receipt"></i>
                                <span>Contas a pagar</span>
                            </a>
                        </li>

                        <li class="sidebar-title">Conta</li>

                        <li class="sidebar-item">
                            <a href="/login" class="sidebar-link">
                                <i class="bi bi-box-arrow-right"></i>
                                <span>Sair</span>
                            </a>
                        </li>

                    </ul>
                </div>

            </div>
        </div>

        <!-- CONTEÚDO PRINCIPAL -->
        <div id="main">

            <header class="mb-3">
                <a href="#" class="burger-btn d-block d-xl-none">
                    <i class="bi bi-justify fs-3"></i>
                </a>
            </header>

            <!-- Cada página colocará seu conteúdo aqui -->
            {% block content %}
            {% endblock %}

            <footer class="mt-5">
                <div class="footer clearfix mb-0">
                    <div class="float-start">
                        <p>CoopFinance — Desenvolvimento Web III</p>
                    </div>
                </div>
            </footer>

        </div>

    </div>

    <!-- JavaScript do Mazer -->
    <script src="/assets/static/js/components/dark.js"></script>
    <script src="/assets/extensions/perfect-scrollbar/perfect-scrollbar.min.js"></script>
    <script src="/assets/compiled/js/app.js"></script>

    <!-- Scripts específicos de cada página -->
    {% block scripts %}
    {% endblock %}

</body>
</html>
